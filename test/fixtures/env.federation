# memora-cli environment for deploy/federation (3-node SQLite federation)
# Usage: source test/fixtures/env.federation
#
# Targets node1 by default. Override MEMORA_ENDPOINT to reach node2/node3:
#   MEMORA_ENDPOINT=http://localhost:7772  (node2)
#   MEMORA_ENDPOINT=http://localhost:7773  (node3)
export MEMORA_ENDPOINT="http://localhost:7771"
export MEMORA_API_KEY="memora-fed-key-1"

# Per-node API keys for multi-node tests:
export MEMORA_FED_NODE1_ENDPOINT="http://localhost:7771"
export MEMORA_FED_NODE1_API_KEY="memora-fed-key-1"
export MEMORA_FED_NODE2_ENDPOINT="http://localhost:7772"
export MEMORA_FED_NODE2_API_KEY="memora-fed-key-2"
export MEMORA_FED_NODE3_ENDPOINT="http://localhost:7773"
export MEMORA_FED_NODE3_API_KEY="memora-fed-key-3"
