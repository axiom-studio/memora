# memora-cli environment for deploy/federation-prod (3-node Postgres+pgvector federation)
# Usage: source test/fixtures/env.federation-prod
#
# Targets node1 by default. Override MEMORA_ENDPOINT to reach node2/node3:
#   MEMORA_ENDPOINT=http://localhost:7772  (node2)
#   MEMORA_ENDPOINT=http://localhost:7773  (node3)
#
# API keys are the secrets from deploy/federation-prod/.env (no keys are
# committed, #5988). Load them first:  set -a; . deploy/federation-prod/.env; set +a
: "${MEMORA_NODE1_API_KEY:?load deploy/federation-prod/.env first}"
export MEMORA_ENDPOINT="http://localhost:7771"
export MEMORA_API_KEY="$MEMORA_NODE1_API_KEY"

# Per-node API keys for multi-node tests:
export MEMORA_FED_NODE1_ENDPOINT="http://localhost:7771"
export MEMORA_FED_NODE1_API_KEY="$MEMORA_NODE1_API_KEY"
export MEMORA_FED_NODE2_ENDPOINT="http://localhost:7772"
export MEMORA_FED_NODE2_API_KEY="$MEMORA_NODE2_API_KEY"
export MEMORA_FED_NODE3_ENDPOINT="http://localhost:7773"
export MEMORA_FED_NODE3_API_KEY="$MEMORA_NODE3_API_KEY"

# Node IDs ([node] id in this stack's node*.toml) and the URLs the nodes
# reach each other on inside the compose network, for federation tests.
export MEMORA_FED_NODE1_ID="2f7b9c02-4d3e-4b8a-8e61-000000000001"
export MEMORA_FED_NODE2_ID="2f7b9c02-4d3e-4b8a-8e61-000000000002"
export MEMORA_FED_NODE3_ID="2f7b9c02-4d3e-4b8a-8e61-000000000003"
export MEMORA_FED_NODE1_PEER_URL="http://memora-node1:7777"
export MEMORA_FED_NODE2_PEER_URL="http://memora-node2:7777"
