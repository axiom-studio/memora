# memora-cli environment for the root docker-compose (single dev node)
# Usage: source test/fixtures/env.dev
#
# The API key is the one in the repo-root .env (no key is committed, #6032).
# Load it first:  set -a; . ./.env; set +a
: "${MEMORA_API_KEY:?load the repo-root .env first}"
export MEMORA_ENDPOINT="http://localhost:7777"
export MEMORA_API_KEY
