# Copy to .env (gitignored) and replace every value before `docker compose up`.
# Generate URL-safe secrets, e.g.:  openssl rand -hex 24
# The Postgres password is embedded in connection URLs, so keep it URL-safe
# (hex or [A-Za-z0-9] only).
POSTGRES_PASSWORD=
MEMORA_NODE1_API_KEY=
MEMORA_NODE2_API_KEY=
MEMORA_NODE3_API_KEY=
